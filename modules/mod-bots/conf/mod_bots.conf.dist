#
# mod-bots configuration
#
# Installed to worldserver.conf.d/, which the worldserver loads after worldserver.conf.
# Change settings in mod_bots.conf; mod_bots.conf.dist is replaced on every install.
#

# Settings must be in the [worldserver] section, like worldserver.conf.
[worldserver]

###################################################################################################
# mod-bots
#
#    Bots.Enable
#        Description: Player bots. Turning it off with ".reload config" logs every bot out.
#        Default:     1 - Enabled
#                     0 - Disabled
#

Bots.Enable = 1

#
#    Bots.Population.Count
#        Description: How many bot characters the server creates and keeps online, half Alliance and
#                     half Horde (an odd number is rounded down). Race and class follow the WotLK
#                     census (bot_census), names come from bot_names. Characters are created once
#                     and kept; lowering the number logs the extra bots out.
#                     Off for now, while work is on companions and progression.
#        Default:     0    - No bot population (players can still log in their own alts as bots)
#                     1000 - The population the questing was tested with
#

Bots.Population.Count = 0

#
#    Bots.Population.LoginsPerSecond
#        Description: How many bots log in per second until the population is online, so they don't
#                     all load at once after a restart.
#        Default:     10
#

Bots.Population.LoginsPerSecond = 10

#
#    Bots.Population.CharactersPerAccount
#        Description: Bot characters per bot account (BOT0001, BOT0002, ...). At most 10, the
#                     client's limit.
#        Default:     10
#

Bots.Population.CharactersPerAccount = 10

#
#    Bots.Questing.Enable
#        Description: The server's own bots quest on their own: they take quests near them, kill and
#                     loot what the quests need, hand them in, equip better rewards, learn spells and
#                     spend talents as they level, and grind when there is nothing else to do.
#                     Off for now: it is being redesigned (doc/BOT_QUESTING_PLAN.md).
#        Default:     0 - Disabled (they stand where they logged in)
#                     1 - Enabled
#

Bots.Questing.Enable = 0
